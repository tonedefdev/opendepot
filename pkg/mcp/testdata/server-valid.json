{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tonedefdev/opendepot-search",
  "title": "OpenDepot Search",
  "description": "Searches OpenDepot modules and providers",
  "version": "1.2.0",
  "websiteUrl": "https://opendepot.example.com",
  "repository": {
    "url": "https://github.com/tonedefdev/opendepot",
